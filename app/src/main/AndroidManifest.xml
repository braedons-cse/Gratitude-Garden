<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ConnectivityMonitor: refresh when the connection comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+ (API 33) requires a runtime grant to post notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm the reminder after a reboot (AlarmManager alarms don't persist). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".GratitudeGardenApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GratitudeGarden">
        <!-- Sentry starts from the Application (util.Diagnostics), with the scrubbing set up
             and only when the build has a DSN; not from its own startup provider. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.GratitudeGarden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fires when the daily reminder alarm (or its snooze) goes off; posts the
             notification. Also the notification's "Later". -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!-- A thought written straight into the reminder notification. -->
        <receiver
            android:name=".notifications.ReplyReceiver"
            android:exported="false" />

        <!-- The home-screen widget. Also takes its midnight alarm and clock / time zone
             changes (both exempt from the implicit-broadcast limits). -->
        <receiver
            android:name=".widget.GardenWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/garden_widget_info" />
        </receiver>

        <!-- Re-arms the reminder after reboot / app update. Exported so the system
             can deliver BOOT_COMPLETED. -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Hands the camera app a file to write a photo into. Only the camera folder in
             the cache is shared (res/xml/file_paths.xml). No CAMERA permission: the camera
             app takes the picture, so there's nothing to ask for. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+. Same exclusions as backup_rules.xml
   (read on Android 11 and lower); keep the two in step. Device transfer is covered too:
   copying a session to a new phone moves the refresh token along with it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="garden.db" />
        <exclude domain="database" path="garden.db-wal" />
        <exclude domain="database" path="garden.db-shm" />
        <exclude domain="database" path="garden.db-journal" />
        <exclude domain="sharedpref" path="com.gratitudegarden.app_preferences.xml" />
        <exclude domain="sharedpref" path="com.gratitudegarden.app.staging_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="garden.db" />
        <exclude domain="database" path="garden.db-wal" />
        <exclude domain="database" path="garden.db-shm" />
        <exclude domain="database" path="garden.db-journal" />
        <exclude domain="sharedpref" path="com.gratitudegarden.app_preferences.xml" />
        <exclude domain="sharedpref" path="com.gratitudegarden.app.staging_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
